# Copy to .env and fill in, then `npm run build`.
#
# Every VITE_ value is baked into the built files, so a change here needs a
# rebuild and redeploy — and nothing here is a secret. Anything you would not
# put on a billboard belongs in the backend's .env, not this one.
#
# The build refuses to start if any of the four required values is missing,
# because the alternative is a live portal whose browser tab reads
# "%VITE_BRAND_NAME%" or which talks to somebody else's API.

# ---- Required -------------------------------------------------------------

# Where your backend is reachable, including /api/v1.
#   https://hr-api.yourcompany.com/api/v1
VITE_API_BASE_URL=

# What the software is called: sidebar, login screen, browser tab.
VITE_BRAND_NAME=

# Your registered legal name, as printed on contracts and letters.
VITE_COMPANY_NAME=

# The same company in a sentence — fits where the registered name will not.
VITE_COMPANY_SHORT_NAME=

# ---- Printed on documents -------------------------------------------------
# Left blank, the line is simply omitted rather than showing an empty label.

VITE_COMPANY_REG_NO=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_EMAIL=
VITE_COMPANY_WEBSITE=

# Who employment letters and certificates are issued over. This is a decision
# about who signs for the company, not a lookup of whoever currently holds the
# title, which is why it is configuration.
VITE_SIGNATORY_NAME=
VITE_SIGNATORY_TITLE=
