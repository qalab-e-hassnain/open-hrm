{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{alembic/**,tests/**,scripts/**,**/*.md,**/*.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/leave-reminders",
      "schedule": "0 3 * * *"
    }
  ]
}
