# Copy to .env and fill in. Only DATABASE_URL and SECRET_KEY have no default;
# everything else falls back to a value in app/config.py.
#
# This file is the whole of what makes a deployment yours. Nothing about your
# company is compiled into the code — see DEPLOYMENT.md.

# ---- Required -------------------------------------------------------------

# Which rules this process is held to. Anything that is not one of
# development / dev / local / test counts as production, so a typo here makes
# the checks stricter rather than switching them off.
#
# In production the API REFUSES TO START if DEBUG is on, if ALLOWED_ORIGINS is
# "*", if SECRET_KEY is missing, short or copied from an example, or if
# PORTAL_URL is plain http. Each of those is invisible from the outside — the
# portal loads and people sign in while the system is wide open — so it exits
# rather than warns. On a laptop, set this to `development` and they become
# warnings instead.
ENVIRONMENT=production

# Postgres connection string.
#   local     postgresql://<user>@localhost:5432/hrm
#   Supabase  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Put the database in the same region as the API. A database on another
# continent costs ~170ms per query, and a request makes several.
DATABASE_URL=

# Signs the tokens people sign in with. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Left deliberately blank, and startup fails until you fill it in. A shipped
# default would be worse than nothing: it is published here, so anyone who
# has read this repository could sign a token for any account in your
# deployment — administrator included — without knowing a password. For the
# same reason the check rejects anything that looks copied ("change-me",
# "your-secret-key", a single repeated character).
#
# Changing it signs everybody out. Never reuse another deployment's.
SECRET_KEY=

# ---- Who you are ----------------------------------------------------------
# Printed on contracts, letters, payslips and every email.

COMPANY_NAME=Your Company (Pvt) Ltd
COMPANY_REG_NO=
COMPANY_ADDRESS=
COMPANY_EMAIL=hr@yourcompany.com

# Hours ahead of UTC. Attendance is stored in UTC and displayed in local
# time; get this wrong and everybody's check-in reads at the wrong hour.
COMPANY_UTC_OFFSET_HOURS=5

# What the software is called, on emails and at the API root.
APP_NAME=Your Company HRM
BRAND_NAME=Your Company HR

# A square logo over https, shown at the top of every email. Blank shows the
# name alone, which is better than somebody else's mark.
BRAND_LOGO_URL=

# Where your portal is. Emails link here, so a wrong value sends your staff
# to somebody else's login page.
PORTAL_URL=https://hr.yourcompany.com

# Where a reply to an automated email should land. The sender is a no-reply
# address, so without this a reply goes nowhere.
HR_REPLY_TO=hr@yourcompany.com

# How long a chain of refreshes may run before the password is needed again,
# counted from the first sign-in and NOT reset by refreshing. Refresh tokens
# rotate on every use and last REFRESH_TOKEN_EXPIRE_DAYS each, so without a
# ceiling a 7-day token refreshed every 6th day never expires and "remember
# this device" quietly means for ever.
REFRESH_TOKEN_FAMILY_MAX_DAYS=30

# ---- Who may call the API -------------------------------------------------
# Your portal's origin, or a comma-separated list of them. "*" lets any
# website on the internet make requests with a signed-in employee's browser
# and their session; production refuses to start with it.
ALLOWED_ORIGINS=https://hr.yourcompany.com

# Returns tracebacks to callers, which is how a stack trace naming your
# tables and file paths reaches somebody's browser. Production refuses to
# start with it on.
DEBUG=False

# ---- File storage ---------------------------------------------------------
# Profile pictures, CNIC scans, receipts. Without these, uploads fail.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hrm-uploads

# ---- Email ----------------------------------------------------------------
# Leave SMTP_HOST blank to disable outbound mail entirely — useful while
# testing, so nobody is emailed by accident.
#
# Resend:  smtp.resend.com, port 587, user "resend", password = your API key.
# The from address must be on a domain you have verified with them, or mail
# is accepted and silently dropped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourcompany.com
